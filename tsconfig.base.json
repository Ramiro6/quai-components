{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@quai/quai-components": ["libs/quai-components/src/index.ts"],
      "@quai/quai-components/styles": ["libs/quai-components/src/styles"],
      "@quai/quai-directives": ["libs/quai-directives/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "plugins": [
    {
      "name": "@angular/language-service"
    }
  ],
  "exclude": ["node_modules", "tmp"]
}
